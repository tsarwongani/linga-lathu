rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper Functions
    function isSignedIn() { return request.auth != null; }
    function isOwner(userId) { return isSignedIn() && request.auth.uid == userId; }
    function getUserData() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    function hasRole(role) { return isSignedIn() && getUserData().role == role; }
    function isAdmin() { return hasRole('admin'); }
    function isDoctor() { return hasRole('doctor'); }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }

    // Users Collection
    match /users/{userId} {
      allow read: if isSignedIn() && (isOwner(userId) || isAdmin() || isDoctor());
      allow create: if isSignedIn() && isOwner(userId) && 
        incoming().keys().hasAll(['uid', 'fullName', 'phoneNumber', 'role', 'createdAt']) &&
        incoming().role in ['patient', 'doctor', 'admin'] &&
        incoming().uid == userId;
      allow update: if isSignedIn() && isOwner(userId) && 
        incoming().diff(existing()).affectedKeys().hasOnly(['fullName', 'phoneNumber']);
    }

    // Hospitals Collection
    match /hospitals/{hospitalId} {
      allow read: if true; // Publicly readable for status and location
      allow write: if isAdmin();
      
      // Sub-collection: Queue
      match /queue/{queueId} {
        allow read: if true; // Public queue display
        allow create: if isSignedIn() && 
          incoming().patientId == request.auth.uid &&
          incoming().status == 'waiting';
        allow update: if isSignedIn() && (
          (isDoctor() || isAdmin()) && incoming().diff(existing()).affectedKeys().hasOnly(['status'])
        );
      }
    }

    // Appointments Collection
    match /appointments/{appointmentId} {
      allow read: if isSignedIn() && (
        isOwner(existing().patientId) || isDoctor() || isAdmin()
      );
      allow create: if isSignedIn() && 
        incoming().patientId == request.auth.uid &&
        incoming().status == 'scheduled';
      allow update: if isSignedIn() && (
        (isOwner(existing().patientId) && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'timeSlot', 'date'])) ||
        ((isDoctor() || isAdmin()) && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'doctorId']))
      );
    }
  }
}
